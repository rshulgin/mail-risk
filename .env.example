# ---------------------------------------------------------------------------
# Mail Risk Intelligence - example environment
# Copy to `.env`. Every value below has a working default, so the app runs
# with no .env file at all.
# ---------------------------------------------------------------------------

# Which LLM backs the two agents.
#   ollama  (default) - local model, no API key, no network egress
#   gemini            - Google Gemini free tier, needs GEMINI_API_KEY
#   rules             - deterministic heuristics, no model at all
# If the selected provider is unreachable at boot, the app automatically falls
# back to `rules` rather than failing to start. Results are labelled with the
# provider that actually produced them.
LLM_PROVIDER=ollama

# --- Ollama (primary) ------------------------------------------------------
# Install: https://ollama.com  then:  ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# `mistral` is slower but noticeably better at rationales if you have the RAM.

# --- Gemini (optional) -----------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- API -------------------------------------------------------------------
PORT=3001
# Relative paths are resolved from the repo root, not the working directory.
DATABASE_PATH=./data/mail-risk.db
SEED_PATH=./mock_mailbox_data.json

# --- Pipeline tuning -------------------------------------------------------
# Comma-separated domains treated as "inside the organisation". Drives the
# lookalike-domain and personal-recipient heuristics.
INTERNAL_DOMAINS=arcline.com
# Concurrent emails in flight. Keep low for local models.
PIPELINE_CONCURRENCY=2
AGENT_TIMEOUT_MS=60000
AGENT_MAX_RETRIES=2
